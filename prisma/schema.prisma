generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  name          String?
  password      String
  role          String    @default("user")
  rememberToken String?
  createdAt     DateTime? @default(now()) @db.DateTime(3)
  updatedAt     DateTime? @updatedAt @db.DateTime(3)
  reports       Report[]

  @@map("users")
}

model Faculty {
  id_faculty   Int           @id @default(autoincrement())
  name_faculty String        @unique
  createdAt    DateTime?     @default(now()) @db.DateTime(3)
  updatedAt    DateTime?     @updatedAt @db.DateTime(3)
  departments  Department[]

  @@map("faculties")
}

model Department {
  id_department   Int       @id @default(autoincrement())
  name_department String    @unique
  degree_level    String
  id_faculty      Int
  faculty         Faculty   @relation(fields: [id_faculty], references: [id_faculty], onDelete: Cascade)
  createdAt       DateTime? @default(now()) @db.DateTime(3)
  updatedAt       DateTime? @updatedAt @db.DateTime(3)
  locations       Location[]

  @@map("departments")
}

model Category {
  id_category   Int        @id @default(autoincrement())
  name_category String     @unique
  createdAt     DateTime?  @default(now()) @db.DateTime(3)
  updatedAt     DateTime?  @updatedAt @db.DateTime(3)
  locations     Location[]

  @@map("categories")
}

model Location {
  id_location   Int         @id @default(autoincrement())
  student_name  String
  nim           String      @unique @db.VarChar(10)
  name_location String
  description   String      @db.Text
  contact       String      @db.VarChar(15)
  longitude     Decimal     @db.Decimal(11, 8)
  latitude      Decimal     @db.Decimal(10, 8)
  approved_at   DateTime?   @db.Timestamp(0)
  id_category   Int
  id_department Int
  
  category      Category    @relation(fields: [id_category], references: [id_category], onDelete: Cascade)
  department    Department  @relation(fields: [id_department], references: [id_department], onDelete: Cascade)
  images        Image[]
  reports       Report[]

  createdAt     DateTime?   @default(now()) @db.DateTime(3)
  updatedAt     DateTime?   @updatedAt @db.DateTime(3)

  @@unique([name_location, nim])
  @@map("locations")
}

model Report {
  id_report     Int       @id @default(autoincrement())
  title         String
  description   String?   @db.Text
  students      String    @db.Text
  file_path     String    @db.Text
  file_name     String?
  file_size     Int?
  status        String    @default("pending")
  feedback      String?   @db.Text
  verified_at   DateTime? @db.DateTime(3)
  id_location   Int
  id_user       Int
  location      Location  @relation(fields: [id_location], references: [id_location], onDelete: Cascade)
  user          User      @relation(fields: [id_user], references: [id], onDelete: Cascade)
  createdAt     DateTime? @default(now()) @db.DateTime(3)
  updatedAt     DateTime? @updatedAt @db.DateTime(3)

  @@map("reports")
}

model Image {
  id_image    Int       @id @default(autoincrement())
  image_path  String    @db.Text
  alt_text    String?   @db.Text
  id_location Int
  location    Location  @relation(fields: [id_location], references: [id_location], onDelete: Cascade)
  createdAt   DateTime? @default(now()) @db.DateTime(3)
  updatedAt   DateTime? @updatedAt @db.DateTime(3)
  deletedAt   DateTime? @db.DateTime(3)

  @@map("images")
}

model ProfileWeb {
  id          Int       @id @default(autoincrement())
  app_name    String
  logo_path   String    @db.Text
  description String
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  @@map("profile_web")
}
